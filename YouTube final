"""
YouTube Comment Scraper for Corpus Linguistics
================================================
This script collects public comment data from YouTube videos
for the linguistic analysis of selected keywords across two
political-cultural discourse bubbles (Queer/Left and Conservative/Right).

Data Protection Notice (GDPR-compliant):
    - NO personally identifiable information (PII) is stored.
    - Usernames, author IDs, and all user-identifying fields
      returned by the API are discarded before any data is saved.
    - Only anonymised comment text and non-personal metadata
      (date, likes, video URL, channel name) are retained.
    - Data is collected solely for academic research purposes
      in accordance with GDPR Art. 89.

Requirements:
    pip install google-api-python-client openpyxl

Usage:
    1. Insert your API key below (API_KEY)
    2. Add video URLs to LEFT_VIDEOS and RIGHT_VIDEOS
    3. Run: python youtube_corpus_scraper_EN.py
    4. Results are saved to the folder: youtube_output/
"""

import re
import csv
import json
import os
import time
import datetime
from collections import defaultdict

# ── Configuration ──────────────────────────────────────────────────────────────

API_KEY = "YOUR_API_KEY_HERE"

# Maximum comments to retrieve per video (100 per API request, paginated)
MAX_COMMENTS_PER_VIDEO = 3000

# KWIC context window: number of tokens to the left and right of each match
WINDOW = 7

# Rate-limiting pauses (seconds) — prevents API quota exhaustion
PAUSE_BETWEEN_VIDEOS  = 2.0
PAUSE_BETWEEN_BUBBLES = 8.0

# ── Keywords ───────────────────────────────────────────────────────────────────
# Special characters are intentionally NOT stripped from comment text,
# so that self-censored spellings (c*nt, c**t, c.nt, etc.) are captured
# by the Cunt pattern below.

KEYWORD_PATTERNS = [
    {"label": "based",
     "pattern": r"\bbased\b"},

    {"label": "girl",
     "pattern": r"\b(girl|gurl)\b"},

    {"label": "real",
     "pattern": r"\breal\b"},

    {"label": "no bc",
     "pattern": r"\bno\s+bc\b"},

    # Cunt — direct spelling and common self-censored variants
    {"label": "cunt",
     "pattern": (
         r"\b("
         r"cunt\w*"      # cunt, cunts, cunting, ...
         r"|cvnt\w*"     # cvnt  (vowel swap)
         r"|c\*nt\w*"    # c*nt
         r"|cu\*t\w*"    # cu*t
         r"|c\*\*t\w*"   # c**t
         r"|c\.nt\w*"    # c.nt
         r"|c-nt\w*"     # c-nt
         r"|c_nt\w*"     # c_nt
         r"|cnt\b"       # cnt  (vowel-less)
         r")\b"
     )},
]

