# ── Helper Functions ───────────────────────────────────────────────────────────

def extract_video_id(url: str) -> str:
    """Extracts the 11-character video ID from a YouTube URL."""
    for pat in [r"(?:v=|youtu\.be/)([A-Za-z0-9_-]{11})",
                r"(?:embed/)([A-Za-z0-9_-]{11})"]:
        m = re.search(pat, url)
        if m:
            return m.group(1)
    return url  # assume raw ID was passed


def clean_text(text: str) -> str:
    """
    Minimally cleans comment text for linguistic analysis.

    Removes:
        - Hyperlinks (http / https)
        - @Mentions (may contain usernames — PII)
        - Redundant whitespace

    Deliberately preserves:
        - Special characters such as * . - _
          (required to match self-censored keyword variants)
        - Emojis and Unicode characters
        - Original capitalisation
    """
    text = re.sub(r"http\S+", " ", text or "")  # strip URLs
    text = re.sub(r"@\w+",    " ", text)         # strip @mentions (PII risk)
    return re.sub(r"\s+", " ", text).strip()


def tokenize(text: str) -> list:
    """Splits text into whitespace-delimited tokens."""
    return re.findall(r"\S+", text)


def extract_kwic(text: str, kw_def: dict) -> list:
    """
    Extracts KWIC (Key Word in Context) concordance lines for one keyword.

    For each match found in `text`, returns a dict containing:
        - label:        keyword category label
        - matched_form: the exact surface form matched
        - left:         list of WINDOW tokens to the left  (padded with '')
        - right:        list of WINDOW tokens to the right (padded with '')
    """
    results = []
    tokens  = tokenize(text)
    joined  = " ".join(tokens)

    for m in re.finditer(kw_def["pattern"], joined, re.IGNORECASE):
        # Determine the token index of the match start
        char_count = 0
        tok_idx    = -1
        for i, tok in enumerate(tokens):
            if char_count >= m.start():
                tok_idx = i
                break
            char_count += len(tok) + 1
        if tok_idx < 0:
            continue

        mt    = len(tokenize(m.group(0)))
        raw   = tokens[max(0, tok_idx - WINDOW): tok_idx]
        left  = [""] * max(0, WINDOW - len(raw)) + raw
        right = tokens[tok_idx + mt: tok_idx + mt + WINDOW]
        right += [""] * max(0, WINDOW - len(right))

        results.append({
            "label":        kw_def["label"],
            "matched_form": m.group(0),
            "left":         left,
            "right":        right,
        })
    return results

# ── YouTube API ────────────────────────────────────────────────────────────────

def get_youtube_service():
    """Initialises the YouTube Data API v3 service client."""
    try:
        from googleapiclient.discovery import build
        return build("youtube", "v3", developerKey=API_KEY)
    except ImportError:
        print("ERROR: google-api-python-client is not installed.")
        print("Please run: pip install google-api-python-client")
        exit(1)


def fetch_comments(youtube, video_id: str, max_comments: int = 500) -> list:
    """
    Retrieves comments for a video via the YouTube commentThreads endpoint.

    Only anonymised fields are returned. All user-identifying fields
    provided by the API (authorDisplayName, authorChannelId,
    authorProfileImageUrl, authorChannelUrl) are deliberately excluded
    in compliance with GDPR.

    Returns a list of dicts with keys: text, date, likes, reply_count.
    """
    comments   = []
    page_token = None

    while len(comments) < max_comments:
        try:
            response = youtube.commentThreads().list(
                part       = "snippet",
                videoId    = video_id,
                maxResults = min(100, max_comments - len(comments)),
                pageToken  = page_token,
                textFormat = "plainText",
                order      = "relevance",
            ).execute()
        except Exception as e:
            print(f"    API error: {e}")
            break

        for item in response.get("items", []):
            snippet = item["snippet"]["topLevelComment"]["snippet"]
            # PII fields (author name, channel ID, etc.) are NOT stored.
            comments.append({
                "text":        snippet.get("textDisplay", ""),
                "date":        snippet.get("publishedAt", "")[:10],
                "likes":       snippet.get("likeCount", 0),
                "reply_count": item["snippet"].get("totalReplyCount", 0),
            })

        page_token = response.get("nextPageToken")
        if not page_token:
            break

    return comments


def get_video_metadata(youtube, video_id: str) -> dict:
    """
    Retrieves public video metadata (title, channel, statistics).
    Contains no user-level data.
    """
    try:
        response = youtube.videos().list(
            part = "snippet,statistics",
            id   = video_id,
        ).execute()
        if response["items"]:
            item  = response["items"][0]
            snip  = item["snippet"]
            stats = item.get("statistics", {})
            return {
                "title":         snip.get("title", ""),
                "channel":       snip.get("channelTitle", ""),
                "published":     snip.get("publishedAt", "")[:10],
                "view_count":    int(stats.get("viewCount",    0)),
                "comment_count": int(stats.get("commentCount", 0)),
            }
    except Exception as e:
        print(f"    Metadata error: {e}")
    return {}

# ── Main ───────────────────────────────────────────────────────────────────────

def main():
    print("=" * 65)
    print("  YouTube Corpus Scraper for Sociolinguistics")
    print("  Keywords: based | girl | real | no bc | cunt (all variants)")
    print("  Privacy:  no personally identifiable data is stored (GDPR)")
    print("=" * 65)

    if API_KEY == "YOUR_API_KEY_HERE":
        print("\nERROR: Please insert your API key in the configuration section.")
        return

    youtube      = get_youtube_service()
    all_comments = []
    kwic_records = []
    kw_counts    = {k["label"]: 0 for k in KEYWORD_PATTERNS}
    kw_by_bubble = {"left": defaultdict(int), "right": defaultdict(int)}
    video_log    = []

    bubble_groups = [
        ("left",  "LGBT/Left",    LEFT_VIDEOS),
        ("right", "Conservative", RIGHT_VIDEOS),
    ]

    for bubble_idx, (bubble, bubble_lbl, videos) in enumerate(bubble_groups):

        # Pause between bubbles (skip before the first one)
        if bubble_idx > 0:
            print(f"\n{'═' * 65}")
            print(f"  Switching to bubble: {bubble_lbl}")
            print(f"  Pausing {PAUSE_BETWEEN_BUBBLES:.0f}s ...")
            print(f"{'═' * 65}")
            time.sleep(PAUSE_BETWEEN_BUBBLES)

        for video_idx, video_info in enumerate(videos):
            url      = video_info["url"]
            channel  = video_info.get("channel", "")
            video_id = extract_video_id(url)

            # Pause between videos (skip before the first video per bubble)
            if video_idx > 0:
                print(f"  Pausing {PAUSE_BETWEEN_VIDEOS:.0f}s ...")
                time.sleep(PAUSE_BETWEEN_VIDEOS)

            print(f"\n{'─' * 65}")
            print(f"  [{bubble_lbl}] {channel or video_id}  "
                  f"({video_idx + 1}/{len(videos)})")
            print(f"  URL: {url}")

            meta = get_video_metadata(youtube, video_id)
            if meta:
                print(f"  Title:          {meta['title'][:55]}")
                print(f"  Channel:        {meta['channel']}")
                print(f"  Views:          {meta['view_count']:,}")
                print(f"  Total comments: {meta['comment_count']:,}")

            video_log.append({
                "bubble":         bubble_lbl,
                "channel":        channel or meta.get("channel", ""),
                "title":          meta.get("title", ""),
                "url":            url,
                "views":          meta.get("view_count", 0),
                "total_comments": meta.get("comment_count", 0),
            })

            print(f"  Fetching comments (max. {MAX_COMMENTS_PER_VIDEO:,}) ...")
            raw_comments = fetch_comments(youtube, video_id, MAX_COMMENTS_PER_VIDEO)
            print(f"  Retrieved: {len(raw_comments):,} comments")

            hit_count = 0
            for comment in raw_comments:
                text = clean_text(comment["text"])
                if not text:
                    continue

                # Store only anonymised fields — no username
                all_comments.append({
                    "bubble":  bubble_lbl,
                    "channel": channel or meta.get("channel", ""),
                    "date":    comment["date"],
                    "likes":   comment["likes"],
                    "text":    text,
                    "url":     url,
                })

                for kw_def in KEYWORD_PATTERNS:
                    for hit in extract_kwic(text, kw_def):
                        kw_counts[kw_def["label"]] += 1
                        kw_by_bubble[bubble][kw_def["label"]] += 1
                        hit_count += 1
                        kwic_records.append({
                            "bubble":        bubble_lbl,
                            "channel":       channel or meta.get("channel", ""),
                            "date":          comment["date"],
                            "keyword_label": hit["label"],
                            "matched_form":  hit["matched_form"],
                            "L7": hit["left"][0], "L6": hit["left"][1],
                            "L5": hit["left"][2], "L4": hit["left"][3],
                            "L3": hit["left"][4], "L2": hit["left"][5],
                            "L1": hit["left"][6],
                            "R1": hit["right"][0], "R2": hit["right"][1],
                            "R3": hit["right"][2], "R4": hit["right"][3],
                            "R5": hit["right"][4], "R6": hit["right"][5],
                            "R7": hit["right"][6],
                            "full_text": text,
                            "video_url":     url,
                        })

            print(f"  KWIC hits: {hit_count:,}")

    # ── Output ─────────────────────────────────────────────────────────────────
    os.makedirs("youtube_output", exist_ok=True)
    KW_LABELS = [k["label"] for k in KEYWORD_PATTERNS]

    # Anonymised comments CSV
    comment_fields = ["bubble", "channel", "date", "likes", "text", "url"]
    with open("youtube_output/yt_comments_clean.csv", "w",
              newline="", encoding="utf-8-sig") as f:
        w = csv.DictWriter(f, fieldnames=comment_fields,
                           quoting=csv.QUOTE_ALL, extrasaction="ignore")
        w.writeheader()
        w.writerows(all_comments)

    # Anonymised KWIC CSV
    kwic_fields = [
        "bubble", "channel", "date", "keyword_label", "matched_form",
        "L7","L6","L5","L4","L3","L2","L1",
        "R1","R2","R3","R4","R5","R6","R7",
        "full_text", "video_url",
    ]
    with open("youtube_output/yt_kwic.csv", "w",
              newline="", encoding="utf-8-sig") as f:
        w = csv.DictWriter(f, fieldnames=kwic_fields, quoting=csv.QUOTE_ALL)
        w.writeheader()
        w.writerows(kwic_records)

    # Excel workbook
    try:
        import openpyxl
        from openpyxl.styles import PatternFill, Font

        wb       = openpyxl.Workbook()
        ws       = wb.active
        ws.title = "Keyword Summary"
        hdr_fill = PatternFill("solid", fgColor="1D9E75")
        hdr_font = Font(bold=True, color="FFFFFF")

        for col, h in enumerate(
            ["Keyword", "Total", "LEFT (LGBT)", "RIGHT (Conservative)",
             "Example KWIC"], 1
        ):
            cell = ws.cell(1, col, h)
            cell.fill = hdr_fill
            cell.font = hdr_font

        examples = {}
        for r in kwic_records:
            kw = r["keyword_label"]
            if kw not in examples:
                l  = " ".join(t for t in
                     [r["L7"],r["L6"],r["L5"],r["L4"],
                      r["L3"],r["L2"],r["L1"]] if t)
                ri = " ".join(t for t in
                     [r["R1"],r["R2"],r["R3"],r["R4"],
                      r["R5"],r["R6"],r["R7"]] if t)
                examples[kw] = f"{l} >>> {r['matched_form']} <<< {ri}"

        for i, kw in enumerate(KW_LABELS, 2):
            ws.cell(i, 1, kw)
            ws.cell(i, 2, kw_counts[kw])
            ws.cell(i, 3, kw_by_bubble["left"][kw])
            ws.cell(i, 4, kw_by_bubble["right"][kw])
            ws.cell(i, 5, examples.get(kw, "—"))
        ws.column_dimensions["A"].width = 12
        ws.column_dimensions["B"].width = 8
        ws.column_dimensions["C"].width = 14
        ws.column_dimensions["D"].width = 20
        ws.column_dimensions["E"].width = 80

        ws2 = wb.create_sheet("Videos")
        ws2.append(["Bubble", "Channel", "Title", "URL",
                    "Views", "Total Comments"])
        for v in video_log:
            ws2.append([v["bubble"], v["channel"], v["title"],
                        v["url"], v["views"], v["total_comments"]])
        ws2.column_dimensions["C"].width = 60

        ws3 = wb.create_sheet("Comments (anon.)")
        ws3.append(comment_fields)
        for r in all_comments:
            ws3.append([r["bubble"], r["channel"], r["date"],
                        r["likes"], r["text"][:500], r["url"]])
        ws3.column_dimensions["E"].width = 80

        ws4 = wb.create_sheet("KWIC Hits")
        ws4.append(kwic_fields)
        for r in kwic_records:
            ws4.append([r[f] for f in kwic_fields])

        wb.save("youtube_output/yt_corpus.xlsx")
        print("\nExcel saved: youtube_output/yt_corpus.xlsx")

    except ImportError:
        print("\nNote: openpyxl not installed — Excel export skipped.")
        print("Install with: pip install openpyxl")

    # Anonymised JSON
    with open("youtube_output/yt_raw.json", "w", encoding="utf-8") as f:
        json.dump(
            {"comments": all_comments, "kwic": kwic_records},
            f, ensure_ascii=False, indent=2,
        )

    # ── Summary report ─────────────────────────────────────────────────────────
    print(f"\n{'=' * 65}")
    print(f"  COMPLETE — Summary")
    print(f"{'=' * 65}")
    print(f"  Videos processed     : {len(video_log)}")
    print(f"  Comments collected   : {len(all_comments):,}")
    print(f"  KWIC hits            : {len(kwic_records):,}")
    print(f"  PII stored           : none (GDPR Art. 89 compliant)")
    print()
    print("  Keyword counts:")
    for kw in KW_LABELS:
        total = kw_counts[kw]
        left  = kw_by_bubble["left"][kw]
        right = kw_by_bubble["right"][kw]
        bar   = "█" * min(total, 40)
        print(f"    {kw:<8} | {bar} {total:,}  "
              f"(Left: {left} | Right: {right})")
    print()
    print("  Output files in youtube_output/:")
    print("    yt_corpus.xlsx          — Excel workbook (4 sheets, anonymised)")
    print("    yt_kwic.csv             — KWIC concordance lines")
    print("    yt_comments_clean.csv   — Comment text (anonymised)")
    print("    yt_raw.json             — Raw data (anonymised)")


if __name__ == "__main__":
    main()
