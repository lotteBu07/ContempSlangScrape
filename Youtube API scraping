# ── Hilfsfunktionen ────────────────────────────────────────────────────────────

def extract_video_id(url: str) -> str:
    """Extrahiert die Video-ID aus einer YouTube-URL."""
    patterns = [
        r"(?:v=|youtu\.be/)([A-Za-z0-9_-]{11})",
        r"(?:embed/)([A-Za-z0-9_-]{11})",
    ]
    for pat in patterns:
        m = re.search(pat, url)
        if m:
            return m.group(1)
    return url  # Falls schon eine ID übergeben wird

def clean_text(text: str) -> str:
    """Bereinigt Text für Analyse."""
    text = re.sub(r"http\S+", " ", text or "")        # URLs entfernen
    text = re.sub(r"@\w+", " ", text)                  # Mentions entfernen      
    return re.sub(r"\s+", " ", text).strip()

def tokenize(text: str) -> list:
    return re.findall(r"\S+", text)

def extract_kwic(text: str, kw_def: dict) -> list:
    """Extrahiert alle KWIC-Treffer für ein Keyword."""
    results = []
    tokens  = tokenize(text)
    joined  = " ".join(tokens)

    for m in re.finditer(kw_def["pattern"], joined, re.IGNORECASE):
        char_count = 0
        tok_idx    = -1
        for i, tok in enumerate(tokens):
            if char_count >= m.start():
                tok_idx = i
                break
            char_count += len(tok) + 1
        if tok_idx < 0:
            continue

        mt    = len(tokenize(m.group(0)))
        raw   = tokens[max(0, tok_idx - WINDOW): tok_idx]
        left  = [""] * max(0, WINDOW - len(raw)) + raw
        right = tokens[tok_idx + mt: tok_idx + mt + WINDOW]
        right += [""] * max(0, WINDOW - len(right))

        results.append({
            "label":        kw_def["label"],
            "matched_form": m.group(0),
            "left":         left,
            "right":        right,
        })
    return results

# ── YouTube API ────────────────────────────────────────────────────────────────

def get_youtube_service():
    """Erstellt den YouTube API Service."""
    try:
        from googleapiclient.discovery import build
        return build("youtube", "v3", developerKey=API_KEY)
    except ImportError:
        print("FEHLER: google-api-python-client nicht installiert.")
        print("Bitte ausführen: pip install google-api-python-client")
        exit(1)

def fetch_comments(youtube, video_id: str, max_comments: int = 500) -> list:
    """Holt alle Kommentare eines Videos."""
    comments = []
    page_token = None

    while len(comments) < max_comments:
        try:
            request = youtube.commentThreads().list(
                part        = "snippet",
                videoId     = video_id,
                maxResults  = min(100, max_comments - len(comments)),
                pageToken   = page_token,
                textFormat  = "plainText",
                order       = "relevance",
            )
            response = request.execute()
        except Exception as e:
            print(f"    API-Fehler: {e}")
            break

        for item in response.get("items", []):
            snippet = item["snippet"]["topLevelComment"]["snippet"]
            comments.append({
                "text":       snippet.get("textDisplay", ""),
                "author":     snippet.get("authorDisplayName", "[unknown]"),
                "date":       snippet.get("publishedAt", "")[:10],
                "likes":      snippet.get("likeCount", 0),
                "reply_count": item["snippet"].get("totalReplyCount", 0),
            })

        page_token = response.get("nextPageToken")
        if not page_token:
            break

    return comments

def get_video_metadata(youtube, video_id: str) -> dict:
    """Holt Metadaten eines Videos."""
    try:
        response = youtube.videos().list(
            part = "snippet,statistics",
            id   = video_id,
        ).execute()
        if response["items"]:
            item  = response["items"][0]
            snip  = item["snippet"]
            stats = item.get("statistics", {})
            return {
                "title":         snip.get("title", ""),
                "channel":       snip.get("channelTitle", ""),
                "published":     snip.get("publishedAt", "")[:10],
                "view_count":    stats.get("viewCount", 0),
                "comment_count": stats.get("commentCount", 0),
            }
    except Exception as e:
        print(f"    Metadaten-Fehler: {e}")
    return {}

